#ifdef GL_ES
precision mediump float; 
#endif 

const float pi = 3.14; 
const float Two_pi = 6.28; //el doble de pi o TWO PI

uniform float u_time; 
uniform vec2 u_resolution; 
uniform vec2 u_mouse; 

vec3 calculation_hsb2rgb(in vec3 c){
    vec3 rgb = clamp(abs(mod(c.x*6.0 + vec3(1.0,2.0,4.0), 6.0) -3.0)-1.0,0.0,1.0);
    rgb = rgb*rgb*(3.0-2.0*rgb);
    return c.z * mix( vec3(1.0), rgb, c.y);
}

void main(){
    vec2 st = gl_FragCoord.xy / u_resolution; 
    vec3 color = vec3(0.0); 
    vec3 color2 = vec3(0.0); 

    //Integracion en polares. 
    vec2 tocenter =  vec2(0.5) - st; 
    float angle = atan(tocenter.x,tocenter.y); 
    float Radio = length(tocenter) * u_time; 
    float circuferencia = tan(angle); 

    color = calculation_hsb2rgb(vec3((log(circuferencia))+0.5,Radio,1.0)* u_time);
    //color2 = calculation_hsb2rgb(vec3())

    //gl_FragColor = vec4(sin(color)/log(abs(pi)),1.0);
    gl_FragColor = vec4(color,1.0);
}
